# Secret-free deployment values. AWS CLI profile: abe-deploy-user, region: ap-northeast-1.
# Fill verified outputs from infra.yaml; never copy a development .env or app.db.
BETA_DATA_DIR=/var/lib/fuminosuke/data
BETA_CADDY_DIR=/var/lib/fuminosuke/caddy
BETA_WORK_DIR=/var/lib/fuminosuke/work
BETA_PUBLIC_ORIGIN=https://REPLACE_WITH_APPROVED_HOSTNAME
BETA_SITE=REPLACE_WITH_APPROVED_HOSTNAME
BETA_COGNITO_POOL_ID=REPLACE_WITH_POOL_ID
BETA_COGNITO_CLIENT_ID=REPLACE_WITH_CLIENT_ID
BETA_COGNITO_DOMAIN=https://REPLACE.auth.ap-northeast-1.amazoncognito.com
BETA_JOURNAL_BUCKET=REPLACE_WITH_JOURNAL_BUCKET
BETA_BACKUP_BUCKET=REPLACE_WITH_BACKUP_BUCKET
BETA_INSTALLATION_ID=REPLACE_WITH_FIXED_UUID
RENDERER_IMAGE_ID=REPLACE_WITH_VERIFIED_IMAGE_SHA256
RENDERER_SOCKET_DIR=/run/llmocr-renderer
# Only compose.ai.yaml uses this. Host file must be 10001-readable, mode 0400.
BETA_API_KEY_FILE=/etc/llmocr/openai_api_key
