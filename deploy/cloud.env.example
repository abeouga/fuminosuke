# Secret-free deployment values. Use the deployment AWS CLI profile (AWS_PROFILE) and the
# project's Region.
# Fill verified outputs from infra.yaml; never copy a development .env or app.db.
BETA_DATA_DIR=/var/lib/fuminosuke/data
BETA_CADDY_DIR=/var/lib/fuminosuke/caddy
BETA_WORK_DIR=/var/lib/fuminosuke/work
BETA_PUBLIC_ORIGIN=https://REPLACE_WITH_APPROVED_HOSTNAME
BETA_SITE=REPLACE_WITH_APPROVED_HOSTNAME
BETA_COGNITO_POOL_ID=REPLACE_WITH_POOL_ID
BETA_COGNITO_CLIENT_ID=REPLACE_WITH_CLIENT_ID
BETA_COGNITO_DOMAIN=https://REPLACE.auth.ap-northeast-1.amazoncognito.com
BETA_JOURNAL_BUCKET=REPLACE_WITH_JOURNAL_BUCKET
BETA_BACKUP_BUCKET=REPLACE_WITH_BACKUP_BUCKET
BETA_INSTALLATION_ID=REPLACE_WITH_FIXED_UUID
RENDERER_IMAGE_ID=REPLACE_WITH_VERIFIED_IMAGE_SHA256
RENDERER_SOCKET_DIR=/run/llmocr-renderer
# Only compose.ai.yaml uses this. Host file must be 10001-readable, mode 0400.
BETA_API_KEY_FILE=/etc/llmocr/openai_api_key

# Fargate task: the task definition sets these (compose does not pass them). Fargate also
# needs PostgreSQL, the objects bucket, the journal and backups (backend/app/cloud/config.py).
# AWS_REGION=ap-northeast-1
# BETA_OBJECT_BUCKET=REPLACE_WITH_OBJECTS_BUCKET
# BETA_DATABASE_HOST=REPLACE_WITH_DB_ENDPOINT
# BETA_DATABASE_PORT=5432
# BETA_DATABASE_NAME=REPLACE_WITH_DB_NAME
# BETA_DATABASE_USER=REPLACE_WITH_DB_USER
# BETA_DATABASE_PASSWORD comes from its own secret; never write it here.
# BETA_ECS_SERVICE=REPLACE_WITH_ECS_SERVICE_NAME
# BETA_RELAY_PORT=8000
# BETA_EXTRACT_FUNCTION=REPLACE_WITH_EXTRACTION_LAMBDA_NAME
# BETA_SEED_TEMPLATE_DIR=/app/seed_templates
# BETA_ADMIN_SUBJECTS=REPLACE_WITH_COGNITO_SUBS_COMMA_SEPARATED
# BETA_ADMIN_SEED_TEMPLATE_DIR=REPLACE_WITH_ADMIN_TEMPLATE_DIR
# BETA_CHAT_LOG=false
# BETA_SESSION_DAYS=30
# BETA_MAX_USERS=10
