# Local Compose: the host port is loopback-only, without HTTPS or a domain.
# The cloud deployment uses Caddyfile.cloud (HTTPS) instead.
:8080 {
    handle /api/* {
        reverse_proxy backend:8000
    }
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}

