APP_ENV=local
# Next editing contract is enabled only in the isolated development instance.
EDITING_API_ENABLED=false
TEMPLATE_ANALYSIS_ENABLED=false
APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_LEVEL=INFO
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Print PDF conversion: appcontainer (legacy) or wsl (requires installed renderer dependencies).
PRINT_PDF_RENDERER=appcontainer
PRINT_WSL_DISTRIBUTION=Ubuntu-22.04
# Optional: explicit SHA-256 of an installed dedicated runtime image for new print preparation.
# PRINT_WSL_RUNTIME_ID=<64 lowercase hex characters; leave unset for the existing live runtime>

DATA_DIR=./data
DATABASE_URL=sqlite:///./data/app.db
LOG_FILE=./data/logs/app.log

MAX_UPLOAD_BYTES=20971520
MAX_IMAGE_PIXELS=30000000
MAX_IMAGE_EDGE=8000
JOB_MAX_CONCURRENCY=1
JOB_THREAD_WORKERS=1
JOB_POLL_INTERVAL_MS=1000

OCR_PROVIDER=mock
# false hides the switch and requires OCR; true restores the image-only option
OCR_TEXT_RECOGNITION_TOGGLE_ENABLED=false
OPENAI_API_KEY=
OPENAI_PRIMARY_MODEL=
OPENAI_FALLBACK_MODEL=
OPENAI_IMAGE_DETAIL=high
OPENAI_INITIAL_IMAGE_DETAIL=high
OPENAI_RETRY_UNCERTAIN_HIGH_DETAIL=false
OPENAI_MAX_CONCURRENCY=2
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_CALLS_PER_JOB=16
OPENAI_MAX_OUTPUT_TOKENS=12000
OPENAI_TIMEOUT_SECONDS=180
PADDLE_PRESENCE_AUDIT_ENABLED=false
OPENAI_MAX_RETRIES=1
OPENAI_PROMPT_VERSION=mapped-compact-v1
OPENAI_SCHEMA_VERSION=2.0

HANDWRITING_SEGMENTER_MODE=heuristic
HANDWRITING_MODEL_PATH=
HANDWRITING_MODEL_VERSION=
HANDWRITING_THRESHOLD=0.55
HANDWRITING_TILE_SIZE=1024
HANDWRITING_TILE_OVERLAP=128

OPENCV_NUM_THREADS=1
MIN_FEATURE_MATCHES=30
MIN_INLIERS=20
MIN_INLIER_RATIO=0.40
MAX_REPROJECTION_ERROR_PX=5.0
MIN_ECC_SCORE=0.75
MIN_EDGE_OVERLAP=0.70
MIN_TEMPLATE_CONFIDENCE=0.75

# OAuth利用時は未設定にします。無効時に既存シートを使う場合だけ指定します。
# Deprecated: user OAuth is used instead of a service-account key.
# Put the following machine-local values in backend/.env.local, which is ignored by Git.
# Browser-restricted API key for the Google Picker API.
# Google Cloud project number used as the Picker App ID.
# Generate at least 32 random characters. This signs session JWTs and derives
# the local refresh-token encryption key; changing it requires reconnecting Google.
# Voice assistant: the API key is shared server-side with OCR.
VOICE_PROVIDER=openai
VOICE_STT_MODEL=gpt-transcribe
VOICE_PROPOSAL_MODEL=gpt-6.1-sol
VOICE_TTS_MODEL=gpt-4o-mini-tts
VOICE_TTS_VOICE=marin
VOICE_MAX_AUDIO_BYTES=10485760
VOICE_MAX_RECORD_SECONDS=60
# Optional absolute executable path; otherwise FFmpeg is discovered on PATH.
# VOICE_FFMPEG_PATH=

# Direct printing on Windows: the first printer whose name matches this -like wildcard
# (the default printer first).
PRINTER_NAME_PATTERN=*EPSON*
