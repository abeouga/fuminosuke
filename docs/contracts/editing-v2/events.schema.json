{
  "$defs": {
    "Accepted": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "accepted"
          ]
        },
        "queuePosition": {
          "maximum": 2,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "type",
        "queuePosition"
      ],
      "type": "object"
    },
    "Applied": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "applied"
          ]
        },
        "receipt": {
          "$ref": "#/$defs/Receipt"
        }
      },
      "required": [
        "type",
        "receipt"
      ],
      "type": "object"
    },
    "Choice": {
      "additionalProperties": false,
      "properties": {
        "choiceId": {
          "pattern": "^[A-Za-z0-9_-]{1,128}$",
          "type": "string"
        },
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        "handle": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "choiceId",
        "label",
        "handle"
      ],
      "type": "object"
    },
    "Clarification": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "clarification_required"
          ]
        },
        "question": {
          "$ref": "#/$defs/Question"
        }
      },
      "required": [
        "type",
        "question"
      ],
      "type": "object"
    },
    "Ended": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "cancelled",
            "expired"
          ],
          "type": "string"
        },
        "message": {
          "maxLength": 1000,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "type",
        "message"
      ],
      "type": "object"
    },
    "Error": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 80,
          "minLength": 1,
          "type": "string"
        },
        "message": {
          "maxLength": 1000,
          "minLength": 1,
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "currentRevision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "code",
        "message",
        "retryable",
        "currentRevision"
      ],
      "type": "object"
    },
    "Failure": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "conflict",
            "failed"
          ],
          "type": "string"
        },
        "error": {
          "$ref": "#/$defs/Error"
        }
      },
      "required": [
        "type",
        "error"
      ],
      "type": "object"
    },
    "Focus": {
      "additionalProperties": false,
      "properties": {
        "viewRevision": {
          "minimum": 1,
          "type": "integer"
        },
        "contextRevision": {
          "minimum": 1,
          "type": "integer"
        },
        "interactionEpoch": {
          "minimum": 0,
          "type": "integer"
        },
        "anchors": {
          "items": {
            "$ref": "#/$defs/FocusAnchor"
          },
          "maxItems": 1000,
          "type": "array"
        },
        "primaryAnchorId": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]{1,128}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "viewRevision",
        "contextRevision",
        "interactionEpoch",
        "anchors",
        "primaryAnchorId"
      ],
      "type": "object"
    },
    "FocusAnchor": {
      "additionalProperties": false,
      "properties": {
        "anchorId": {
          "pattern": "^[A-Za-z0-9_-]{1,128}$",
          "type": "string"
        },
        "kind": {
          "enum": [
            "review_field",
            "template_cell"
          ],
          "type": "string"
        },
        "resourceId": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "pageId": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "tableId": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "fieldId": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "cellId": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "rowId": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "columnId": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "label": {
          "maxLength": 300,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "anchorId",
        "kind",
        "resourceId",
        "pageId",
        "tableId",
        "fieldId",
        "cellId",
        "rowId",
        "columnId",
        "label"
      ],
      "type": "object"
    },
    "NoAction": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "no_action"
          ]
        },
        "reason": {
          "enum": [
            "not_an_edit",
            "unchanged"
          ],
          "type": "string"
        },
        "message": {
          "maxLength": 1000,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "type",
        "reason",
        "message"
      ],
      "type": "object"
    },
    "Question": {
      "additionalProperties": false,
      "properties": {
        "questionId": {
          "pattern": "^[A-Za-z0-9_-]{1,128}$",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "type": "integer"
        },
        "missingKind": {
          "enum": [
            "target",
            "table",
            "row",
            "column",
            "value",
            "meaning",
            "name",
            "operation",
            "scope"
          ],
          "type": "string"
        },
        "message": {
          "maxLength": 1000,
          "minLength": 1,
          "type": "string"
        },
        "choices": {
          "items": {
            "$ref": "#/$defs/Choice"
          },
          "maxItems": 12,
          "type": "array"
        },
        "expiresAt": {
          "maxLength": 40,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "questionId",
        "version",
        "missingKind",
        "message",
        "choices",
        "expiresAt"
      ],
      "type": "object"
    },
    "Receipt": {
      "additionalProperties": false,
      "properties": {
        "receiptId": {
          "pattern": "^[A-Za-z0-9_-]{1,128}$",
          "type": "string"
        },
        "operationId": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]{1,128}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "beforeRevision": {
          "minimum": 1,
          "type": "integer"
        },
        "afterRevision": {
          "minimum": 1,
          "type": "integer"
        },
        "notification": {
          "maxLength": 1000,
          "minLength": 1,
          "type": "string"
        },
        "canUndo": {
          "type": "boolean"
        },
        "viewRevision": {
          "minimum": 1,
          "type": "integer"
        },
        "focus": {
          "$ref": "#/$defs/Focus"
        },
        "substitutions": {
          "additionalProperties": false,
          "type": "object",
          "required": []
        }
      },
      "required": [
        "receiptId",
        "operationId",
        "beforeRevision",
        "afterRevision",
        "notification",
        "canUndo",
        "viewRevision",
        "focus",
        "substitutions"
      ],
      "type": "object"
    },
    "TargetFocus": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "target_focus"
          ]
        },
        "phase": {
          "enum": [
            "candidates",
            "resolved"
          ],
          "type": "string"
        },
        "candidateSetId": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]{1,128}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "focus": {
          "$ref": "#/$defs/Focus"
        }
      },
      "required": [
        "type",
        "phase",
        "candidateSetId",
        "focus"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contractVersion": {
      "type": "string",
      "enum": [
        "editing.v2"
      ]
    },
    "eventId": {
      "pattern": "^[A-Za-z0-9_-]{1,128}$",
      "type": "string"
    },
    "sessionId": {
      "pattern": "^[A-Za-z0-9_-]{1,128}$",
      "type": "string"
    },
    "commandId": {
      "pattern": "^[A-Za-z0-9_-]{1,128}$",
      "type": "string"
    },
    "instructionId": {
      "pattern": "^[A-Za-z0-9_-]{1,128}$",
      "type": "string"
    },
    "requestId": {
      "pattern": "^[A-Za-z0-9_-]{1,128}$",
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "type": "integer"
    },
    "emittedAt": {
      "maxLength": 40,
      "minLength": 1,
      "type": "string"
    },
    "payload": {
      "anyOf": [
        {
          "$ref": "#/$defs/Accepted"
        },
        {
          "$ref": "#/$defs/TargetFocus"
        },
        {
          "$ref": "#/$defs/Applied"
        },
        {
          "$ref": "#/$defs/Clarification"
        },
        {
          "$ref": "#/$defs/NoAction"
        },
        {
          "$ref": "#/$defs/Failure"
        },
        {
          "$ref": "#/$defs/Ended"
        }
      ]
    }
  },
  "required": [
    "contractVersion",
    "eventId",
    "sessionId",
    "commandId",
    "instructionId",
    "requestId",
    "sequence",
    "emittedAt",
    "payload"
  ],
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
