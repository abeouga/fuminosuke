{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated model-only plan. Shared operations are bound and validated before saving.",
  "type": "object",
  "properties": {
    "decision": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "change"
              ]
            },
            "change": {
              "$ref": "#/$defs/ChangePlan"
            }
          },
          "required": [
            "kind",
            "change"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "clarify"
              ]
            },
            "knownChange": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ChangePlan"
                },
                {
                  "type": "null"
                }
              ]
            },
            "missing": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "target",
                      "table",
                      "row",
                      "column",
                      "value",
                      "meaning",
                      "name",
                      "operation",
                      "scope"
                    ]
                  },
                  "operationIndex": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 49
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "selectorId": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^s[1-9][0-9]{0,3}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "focusQuote": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  },
                  "candidateRefs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_]{0,39}$"
                    },
                    "minItems": 0,
                    "maxItems": 5
                  }
                },
                "required": [
                  "kind",
                  "operationIndex",
                  "selectorId",
                  "focusQuote",
                  "candidateRefs"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "maxItems": 10
            }
          },
          "required": [
            "kind",
            "knownChange",
            "missing"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "undo_previous"
              ]
            },
            "evidence": {
              "$ref": "#/$defs/Evidence"
            }
          },
          "required": [
            "kind",
            "evidence"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "retarget_previous"
              ]
            },
            "selector": {
              "$ref": "#/$defs/Selector"
            },
            "evidence": {
              "$ref": "#/$defs/Evidence"
            }
          },
          "required": [
            "kind",
            "selector",
            "evidence"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "no_action"
              ]
            },
            "reason": {
              "type": "string",
              "enum": [
                "not_an_edit",
                "cancel_pending",
                "unclear_instruction"
              ]
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "decision"
  ],
  "additionalProperties": false,
  "$defs": {
    "TargetRef": {
      "type": "object",
      "properties": {
        "targetRef": {
          "type": "string",
          "pattern": "^s[1-9][0-9]{0,3}$"
        }
      },
      "required": [
        "targetRef"
      ],
      "additionalProperties": false
    },
    "Evidence": {
      "type": "object",
      "properties": {
        "turnId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      },
      "required": [
        "turnId",
        "quote"
      ],
      "additionalProperties": false
    },
    "ValueIntent": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "text"
              ]
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "evidence": {
              "$ref": "#/$defs/Evidence"
            }
          },
          "required": [
            "kind",
            "text",
            "evidence"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "digits",
                "integer"
              ]
            },
            "spoken": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "evidence": {
              "$ref": "#/$defs/Evidence"
            }
          },
          "required": [
            "kind",
            "spoken",
            "evidence"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "blank"
              ]
            },
            "evidence": {
              "$ref": "#/$defs/Evidence"
            }
          },
          "required": [
            "kind",
            "evidence"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "missing"
              ]
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Selector": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^s[1-9][0-9]{0,3}$"
        },
        "address": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "catalog"
                  ]
                },
                "ref": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_]{0,39}$"
                },
                "evidence": {
                  "$ref": "#/$defs/Evidence"
                }
              },
              "required": [
                "kind",
                "ref",
                "evidence"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "query"
                  ]
                },
                "targetKind": {
                  "type": "string",
                  "enum": [
                    "cell",
                    "field",
                    "meaning",
                    "relation",
                    "heading",
                    "record_section",
                    "record_group",
                    "mark_set",
                    "mark_option",
                    "region",
                    "identity_group",
                    "page"
                  ]
                },
                "mention": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "heading": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "pageRef": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_]{0,39}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "position": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "top",
                        "bottom",
                        "left",
                        "right"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "evidence": {
                  "$ref": "#/$defs/Evidence"
                }
              },
              "required": [
                "kind",
                "targetKind",
                "mention",
                "heading",
                "pageRef",
                "position",
                "evidence"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "record_cell"
                  ]
                },
                "tableRef": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_]{0,39}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "tableMention": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "row": {
                  "type": "integer",
                  "minimum": 1
                },
                "column": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "enum": [
                            "index"
                          ]
                        },
                        "index": {
                          "type": "integer",
                          "minimum": 1
                        }
                      },
                      "required": [
                        "kind",
                        "index"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "enum": [
                            "name"
                          ]
                        },
                        "name": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 100
                        }
                      },
                      "required": [
                        "kind",
                        "name"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "enum": [
                            "catalog"
                          ]
                        },
                        "ref": {
                          "type": "string",
                          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,39}$"
                        }
                      },
                      "required": [
                        "kind",
                        "ref"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                "evidence": {
                  "$ref": "#/$defs/Evidence"
                }
              },
              "required": [
                "kind",
                "tableRef",
                "tableMention",
                "row",
                "column",
                "evidence"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "recent_target"
                  ]
                },
                "evidence": {
                  "$ref": "#/$defs/Evidence"
                }
              },
              "required": [
                "kind",
                "evidence"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "id",
        "address"
      ],
      "additionalProperties": false
    },
    "ChangePlan": {
      "type": "object",
      "properties": {
        "selectors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Selector"
          },
          "minItems": 0,
          "maxItems": 1000
        },
        "operations": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/OcrSetValue"
              },
              {
                "$ref": "#/$defs/CellSetRole"
              },
              {
                "$ref": "#/$defs/CellRename"
              },
              {
                "$ref": "#/$defs/CellSetReading"
              },
              {
                "$ref": "#/$defs/MeaningCreate"
              },
              {
                "$ref": "#/$defs/MeaningUpdate"
              },
              {
                "$ref": "#/$defs/MeaningDelete"
              },
              {
                "$ref": "#/$defs/MeaningBind"
              },
              {
                "$ref": "#/$defs/MeaningUnbind"
              },
              {
                "$ref": "#/$defs/HeadingCreate"
              },
              {
                "$ref": "#/$defs/HeadingUpdate"
              },
              {
                "$ref": "#/$defs/HeadingAttach"
              },
              {
                "$ref": "#/$defs/HeadingDetach"
              },
              {
                "$ref": "#/$defs/HeadingDelete"
              },
              {
                "$ref": "#/$defs/RecordsDefine"
              },
              {
                "$ref": "#/$defs/RecordsReplaceRows"
              },
              {
                "$ref": "#/$defs/RecordsConfigure"
              },
              {
                "$ref": "#/$defs/RecordsDissolve"
              },
              {
                "$ref": "#/$defs/MarkConfigure"
              },
              {
                "$ref": "#/$defs/MarkClear"
              },
              {
                "$ref": "#/$defs/IdentityConfigure"
              },
              {
                "$ref": "#/$defs/DocumentNameConfigure"
              }
            ]
          },
          "minItems": 1,
          "maxItems": 50
        },
        "operationEvidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "maxItems": 50
        }
      },
      "required": [
        "selectors",
        "operations",
        "operationEvidence"
      ],
      "additionalProperties": false
    },
    "CellMeaningRef": {
      "additionalProperties": false,
      "properties": {
        "cell": {
          "anyOf": [
            {
              "$ref": "#/$defs/TargetRef"
            },
            {
              "$ref": "#/$defs/LocalRef"
            }
          ]
        },
        "meaning": {
          "anyOf": [
            {
              "$ref": "#/$defs/TargetRef"
            },
            {
              "$ref": "#/$defs/LocalRef"
            }
          ]
        }
      },
      "required": [
        "cell",
        "meaning"
      ],
      "type": "object"
    },
    "CellRename": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "cell.rename"
          ]
        },
        "cell": {
          "$ref": "#/$defs/TargetRef"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "op",
        "cell",
        "name"
      ],
      "type": "object"
    },
    "CellSetReading": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "cell.set_reading"
          ]
        },
        "cells": {
          "items": {
            "$ref": "#/$defs/TargetRef"
          },
          "maxItems": 1000,
          "minItems": 1,
          "type": "array"
        },
        "reading": {
          "enum": [
            "text",
            "sequence"
          ],
          "type": "string"
        }
      },
      "required": [
        "op",
        "cells",
        "reading"
      ],
      "type": "object"
    },
    "CellSetRole": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "cell.set_role"
          ]
        },
        "cells": {
          "items": {
            "$ref": "#/$defs/TargetRef"
          },
          "maxItems": 1000,
          "minItems": 1,
          "type": "array"
        },
        "role": {
          "enum": [
            "input",
            "label",
            "parent_label",
            "mark",
            "record_key_cell",
            "column_key_cell",
            "ignored"
          ],
          "type": "string"
        }
      },
      "required": [
        "op",
        "cells",
        "role"
      ],
      "type": "object"
    },
    "DocumentNameConfigure": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "document_name.configure"
          ]
        },
        "rule": {
          "anyOf": [
            {
              "$ref": "#/$defs/NameRule"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "op",
        "rule"
      ],
      "type": "object"
    },
    "HeadingAttach": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "heading.attach"
          ]
        },
        "heading": {
          "anyOf": [
            {
              "$ref": "#/$defs/TargetRef"
            },
            {
              "$ref": "#/$defs/LocalRef"
            }
          ]
        },
        "children": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/TargetRef"
              },
              {
                "$ref": "#/$defs/LocalRef"
              }
            ]
          },
          "maxItems": 1000,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "op",
        "heading",
        "children"
      ],
      "type": "object"
    },
    "HeadingCreate": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "heading.create_virtual"
          ]
        },
        "localRef": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,39}$",
          "type": "string"
        },
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "type": "string"
        },
        "page": {
          "anyOf": [
            {
              "$ref": "#/$defs/TargetRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "anchor": {
          "anyOf": [
            {
              "$ref": "#/$defs/TargetRef"
            },
            {
              "$ref": "#/$defs/LocalRef"
            }
          ]
        }
      },
      "required": [
        "op",
        "localRef",
        "name",
        "page",
        "anchor"
      ],
      "type": "object"
    },
    "HeadingDelete": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "heading.delete_virtual"
          ]
        },
        "heading": {
          "anyOf": [
            {
              "$ref": "#/$defs/TargetRef"
            },
            {
              "$ref": "#/$defs/LocalRef"
            }
          ]
        }
      },
      "required": [
        "op",
        "heading"
      ],
      "type": "object"
    },
    "HeadingDetach": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "heading.detach"
          ]
        },
        "children": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/TargetRef"
              },
              {
                "$ref": "#/$defs/LocalRef"
              }
            ]
          },
          "maxItems": 1000,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "op",
        "children"
      ],
      "type": "object"
    },
    "HeadingUpdate": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "heading.update"
          ]
        },
        "heading": {
          "anyOf": [
            {
              "$ref": "#/$defs/TargetRef"
            },
            {
              "$ref": "#/$defs/LocalRef"
            }
          ]
        },
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "op",
        "heading",
        "name"
      ],
      "type": "object"
    },
    "IdentityConfigure": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "identity.configure"
          ]
        },
        "entries": {
          "items": {
            "$ref": "#/$defs/IdentityEntry"
          },
          "maxItems": 20,
          "type": "array"
        }
      },
      "required": [
        "op",
        "entries"
      ],
      "type": "object"
    },
    "IdentityEntry": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "anyOf": [
            {
              "$ref": "#/$defs/TargetRef"
            },
            {
              "$ref": "#/$defs/CellMeaningRef"
            }
          ]
        },
        "valueType": {
          "enum": [
            "text",
            "digits"
          ],
          "type": "string"
        },
        "exactLength": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "matchRole": {
          "enum": [
            "primary",
            "confirmation"
          ],
          "type": "string"
        },
        "displayRole": {
          "enum": [
            "title",
            "subtitle",
            "none"
          ],
          "type": "string"
        },
        "group": {
          "anyOf": [
            {
              "$ref": "#/$defs/TargetRef"
            },
            {
              "$ref": "#/$defs/LocalRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "groupLabel": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "componentOrder": {
          "maximum": 100,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "field",
        "valueType",
        "exactLength",
        "matchRole",
        "displayRole",
        "group",
        "groupLabel",
        "componentOrder"
      ],
      "type": "object"
    },
    "LocalRef": {
      "additionalProperties": false,
      "properties": {
        "localRef": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,39}$",
          "type": "string"
        }
      },
      "required": [
        "localRef"
      ],
      "type": "object"
    },
    "MarkClear": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "mark.clear"
          ]
        },
        "cell": {
          "$ref": "#/$defs/TargetRef"
        }
      },
      "required": [
        "op",
        "cell"
      ],
      "type": "object"
    },
    "MarkConfigure": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "mark.configure"
          ]
        },
        "cell": {
          "$ref": "#/$defs/TargetRef"
        },
        "sets": {
          "items": {
            "$ref": "#/$defs/MarkSetSpec"
          },
          "maxItems": 10,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "op",
        "cell",
