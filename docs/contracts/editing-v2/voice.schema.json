{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Begin": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "utterance.begin",
          "title": "Type",
          "type": "string"
        },
        "utteranceId": {
          "pattern": "^[A-Za-z0-9_-]{1,128}$",
          "title": "Utteranceid",
          "type": "string"
        },
        "binding": {
          "$ref": "#/$defs/Binding"
        }
      },
      "required": [
        "type",
        "utteranceId",
        "binding"
      ],
      "title": "Begin",
      "type": "object"
    },
    "Binding": {
      "additionalProperties": false,
      "properties": {
        "expectedRevision": {
          "minimum": 1,
          "title": "Expectedrevision",
          "type": "integer"
        },
        "contextRevision": {
          "minimum": 1,
          "title": "Contextrevision",
          "type": "integer"
        },
        "interactionEpoch": {
          "minimum": 0,
          "title": "Interactionepoch",
          "type": "integer"
        },
        "catalogRevision": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Catalogrevision",
          "type": "string"
        },
        "scopeDigest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Scopedigest",
          "type": "string"
        }
      },
      "required": [
        "expectedRevision",
        "contextRevision",
        "interactionEpoch",
        "catalogRevision",
        "scopeDigest"
      ],
      "title": "Binding",
      "type": "object"
    },
    "End": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "utterance.end",
          "title": "Type",
          "type": "string"
        },
        "manifest": {
          "items": {
            "pattern": "^[A-Za-z0-9_-]{1,128}$",
            "type": "string"
          },
          "maxItems": 180,
          "minItems": 1,
          "title": "Manifest",
          "type": "array"
        },
        "reason": {
          "enum": [
            "silence",
            "local_stop"
          ],
          "title": "Reason",
          "type": "string"
        },
        "silenceMs": {
          "maximum": 30000,
          "minimum": 0,
          "title": "Silencems",
          "type": "integer"
        }
      },
      "required": [
        "type",
        "manifest",
        "reason",
        "silenceMs"
      ],
      "title": "End",
      "type": "object"
    },
    "SegmentBegin": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "segment.begin",
          "title": "Type",
          "type": "string"
        },
        "segmentId": {
          "pattern": "^[A-Za-z0-9_-]{1,128}$",
          "title": "Segmentid",
          "type": "string"
        },
        "sequence": {
          "maximum": 180,
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        }
      },
      "required": [
        "type",
        "segmentId",
        "sequence"
      ],
      "title": "SegmentBegin",
      "type": "object"
    },
    "SegmentEnd": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "segment.end",
          "title": "Type",
          "type": "string"
        },
        "segmentId": {
          "pattern": "^[A-Za-z0-9_-]{1,128}$",
          "title": "Segmentid",
          "type": "string"
        }
      },
      "required": [
        "type",
        "segmentId"
      ],
      "title": "SegmentEnd",
      "type": "object"
    },
    "Simple": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "speech.stopped",
            "utterance.cancel",
            "capture.stop"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "Simple",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "capture.stop": "#/$defs/Simple",
      "segment.begin": "#/$defs/SegmentBegin",
      "segment.end": "#/$defs/SegmentEnd",
      "speech.stopped": "#/$defs/Simple",
      "utterance.begin": "#/$defs/Begin",
      "utterance.cancel": "#/$defs/Simple",
      "utterance.end": "#/$defs/End"
    },
    "propertyName": "type"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/Begin"
    },
    {
      "$ref": "#/$defs/SegmentBegin"
    },
    {
      "$ref": "#/$defs/SegmentEnd"
    },
    {
      "$ref": "#/$defs/End"
    },
    {
      "$ref": "#/$defs/Simple"
    }
  ],
  "title": "VoiceV2Control"
}
