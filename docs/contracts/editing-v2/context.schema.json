{
  "$defs": {
    "ContextUpdate": {
      "additionalProperties": false,
      "properties": {
        "contractVersion": {
          "type": "string",
          "enum": [
            "editing.v2"
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "context_update"
          ]
        },
        "expectedRevision": {
          "minimum": 1,
          "type": "integer"
        },
        "expectedContextRevision": {
          "minimum": 1,
          "type": "integer"
        },
        "interactionEpoch": {
          "minimum": 0,
          "type": "integer"
        },
        "resource": {
          "$ref": "#/$defs/Resource"
        },
        "mode": {
          "enum": [
            "manual",
            "continuous",
            "local"
          ],
          "type": "string"
        },
        "pageScope": {
          "$ref": "#/$defs/PageScope"
        },
        "selectedTableId": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "selectedHandles": {
          "items": {
            "pattern": "^t_[a-f0-9]{64}$",
            "type": "string"
          },
          "maxItems": 1000,
          "type": "array"
        },
        "localTargetHandle": {
          "anyOf": [
            {
              "pattern": "^t_[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "contractVersion",
        "kind",
        "expectedRevision",
        "expectedContextRevision",
        "interactionEpoch",
        "resource",
        "mode",
        "pageScope",
        "selectedTableId",
        "selectedHandles",
        "localTargetHandle"
      ],
      "type": "object"
    },
    "Focus": {
      "additionalProperties": false,
      "properties": {
        "viewRevision": {
          "minimum": 1,
          "type": "integer"
        },
        "contextRevision": {
          "minimum": 1,
          "type": "integer"
        },
        "interactionEpoch": {
          "minimum": 0,
          "type": "integer"
        },
        "anchors": {
          "items": {
            "$ref": "#/$defs/FocusAnchor"
          },
          "maxItems": 1000,
          "type": "array"
        },
        "primaryAnchorId": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]{1,128}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "viewRevision",
        "contextRevision",
        "interactionEpoch",
        "anchors",
        "primaryAnchorId"
      ],
      "type": "object"
    },
    "FocusAnchor": {
      "additionalProperties": false,
      "properties": {
        "anchorId": {
          "pattern": "^[A-Za-z0-9_-]{1,128}$",
          "type": "string"
        },
        "kind": {
          "enum": [
            "review_field",
            "template_cell"
          ],
          "type": "string"
        },
        "resourceId": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "pageId": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "tableId": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "fieldId": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "cellId": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "rowId": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "columnId": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "label": {
          "maxLength": 300,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "anchorId",
        "kind",
        "resourceId",
        "pageId",
        "tableId",
        "fieldId",
        "cellId",
        "rowId",
        "columnId",
        "label"
      ],
      "type": "object"
    },
    "PageScope": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "current",
            "all"
          ],
          "type": "string"
        },
        "pageId": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "mode",
        "pageId"
      ],
      "type": "object"
    },
    "Resource": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "ocr",
            "template"
          ],
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "type": "object"
    },
    "ScopeSnapshot": {
      "additionalProperties": false,
      "properties": {
        "contractVersion": {
          "type": "string",
          "enum": [
            "editing.v2"
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "scope_snapshot"
          ]
        },
        "resourceRevision": {
          "minimum": 1,
          "type": "integer"
        },
        "contextRevision": {
          "minimum": 1,
          "type": "integer"
        },
        "interactionEpoch": {
          "minimum": 0,
          "type": "integer"
        },
        "resource": {
          "$ref": "#/$defs/Resource"
        },
        "mode": {
          "enum": [
            "manual",
            "continuous",
            "local"
          ],
          "type": "string"
        },
        "pageScope": {
          "$ref": "#/$defs/PageScope"
        },
        "selectedTableId": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "selectedHandles": {
          "items": {
            "pattern": "^t_[a-f0-9]{64}$",
            "type": "string"
          },
          "maxItems": 1000,
          "type": "array"
        },
        "localTargetHandle": {
          "anyOf": [
            {
              "pattern": "^t_[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "recentTableId": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "catalogRevision": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "scopeDigest": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "currentFocus": {
          "anyOf": [
            {
              "$ref": "#/$defs/Focus"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "contractVersion",
        "kind",
        "resourceRevision",
        "contextRevision",
        "interactionEpoch",
        "resource",
        "mode",
        "pageScope",
        "selectedTableId",
        "selectedHandles",
        "localTargetHandle",
        "recentTableId",
        "catalogRevision",
        "scopeDigest",
        "currentFocus"
      ],
      "type": "object"
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/ContextUpdate"
    },
    {
      "$ref": "#/$defs/ScopeSnapshot"
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
