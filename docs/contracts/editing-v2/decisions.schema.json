{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Internal Decisions adapter contract, not OpenAI wire JSON. Exactly three distinct sentinels per question, complete coverage, unique IDs, span evidence and proposal binding must be validated in application.",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "candidate_snapshot"
          ]
        },
        "contractVersion": {
          "type": "string",
          "enum": [
            "editing.v2"
          ]
        },
        "candidateSetId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "bindingDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "policyVersion": {
          "type": "string",
          "enum": [
            "decisions-first-v2"
          ]
        },
        "catalogRevision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "scopeDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "coverageComplete": {
          "type": "boolean",
          "const": true
        },
        "clauses": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "clauseId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,128}$"
              },
              "turnId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,128}$"
              },
              "span": {
                "type": "object",
                "properties": {
                  "start": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "start",
                  "end"
                ],
                "additionalProperties": false
              },
              "quote": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "valueIntent": {
                "$ref": "planner.schema.json#/$defs/ValueIntent"
              }
            },
            "required": [
              "clauseId",
              "turnId",
              "span",
              "quote",
              "valueIntent"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 4
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,128}$"
              },
              "clauseId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,128}$"
              },
              "choices": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "enum": [
                            "apply"
                          ]
                        },
                        "value": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9_-]{1,128}$"
                        },
                        "description": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 500
                        },
                        "proposalRef": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9_-]{1,128}$"
                        }
                      },
                      "required": [
                        "kind",
                        "value",
                        "description",
                        "proposalRef"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "enum": [
                            "sentinel"
                          ]
                        },
                        "value": {
                          "type": "string",
                          "enum": [
                            "clarify",
                            "responses",
                            "no_action"
                          ]
                        },
                        "description": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 500
                        }
                      },
                      "required": [
                        "kind",
                        "value",
                        "description"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                "minItems": 4,
                "maxItems": 255
              }
            },
            "required": [
              "name",
              "clauseId",
              "choices"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 4
        }
      },
      "required": [
        "kind",
        "contractVersion",
        "candidateSetId",
        "bindingDigest",
        "policyVersion",
        "catalogRevision",
        "scopeDigest",
        "coverageComplete",
        "clauses",
        "questions"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "selection_result"
          ]
        },
        "contractVersion": {
          "type": "string",
          "enum": [
            "editing.v2"
          ]
        },
        "candidateSetId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "bindingDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "answers": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "choice"
                    ]
                  },
                  "name": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,128}$"
                  },
                  "choice": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,128}$"
                  },
                  "confidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "probabilities": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "value": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9_-]{1,128}$"
                        },
                        "probability": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        }
                      },
                      "required": [
                        "value",
                        "probability"
                      ],
                      "additionalProperties": false
                    },
                    "minItems": 4,
                    "maxItems": 255
                  }
                },
                "required": [
                  "type",
                  "name",
                  "choice",
                  "confidence",
                  "probabilities"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "refusal"
                    ]
                  },
                  "name": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,128}$"
                  }
                },
                "required": [
                  "type",
                  "name"
                ],
                "additionalProperties": false
              }
            ]
          },
          "minItems": 1,
          "maxItems": 4
        }
      },
      "required": [
        "kind",
        "contractVersion",
        "candidateSetId",
        "bindingDigest",
        "answers"
      ],
      "additionalProperties": false
    }
  ]
}
