{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fuminosuke:template-analysis:selection-projection:v6:prototype1",
  "title": "Server-projected Decisions answers; not the raw provider response",
  "type": "object",
  "properties": {
    "model": {"const": "gpt-6-luna"},
    "answers": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "type": {"const": "choice"},
              "choice": {"type": "string", "minLength": 1},
              "confidence": {"type": "number", "minimum": 0, "maximum": 1},
              "probabilities": {
                "type": "array", "minItems": 2, "maxItems": 32,
                "items": {
                  "type": "object",
                  "properties": {"value": {"type": "string"}, "probability": {"type": "number", "minimum": 0, "maximum": 1}},
                  "required": ["value", "probability"], "additionalProperties": false
                }
              }
            },
            "required": ["name", "type", "choice", "confidence", "probabilities"], "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {"name": {"type": "string", "minLength": 1}, "type": {"const": "refusal"}},
            "required": ["name", "type"], "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": ["model", "answers"],
  "additionalProperties": false
}
