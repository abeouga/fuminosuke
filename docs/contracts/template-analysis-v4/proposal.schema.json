{
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "enum": [
        "template-analysis.compact.v4"
      ]
    },
    "marks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Mark"
      },
      "minItems": 0,
      "maxItems": 500
    },
    "units": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/Fields"
          },
          {
            "$ref": "#/$defs/Form"
          },
          {
            "$ref": "#/$defs/Records"
          }
        ]
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "roles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RoleGroup"
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "headings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Cell"
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "hierarchy": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Hierarchy"
      },
      "minItems": 0,
      "maxItems": 1000
    }
  },
  "required": [
    "version",
    "marks",
    "units",
    "roles",
    "headings",
    "hierarchy"
  ],
  "additionalProperties": false,
  "$defs": {
    "Cell": {
      "type": "string",
      "pattern": "^c[1-9][0-9]{0,3}$"
    },
    "Grid": {
      "type": "string",
      "pattern": "^g[1-9][0-9]?$"
    },
    "Row": {
      "type": "string",
      "pattern": "^r[1-9][0-9]{0,2}$"
    },
    "Column": {
      "type": "string",
      "pattern": "^k[1-9][0-9]{0,2}$"
    },
    "Name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "MarkRef": {
      "type": "string",
      "pattern": "^m[1-9][0-9]{0,2}$"
    },
    "Reading": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "text"
          ]
        },
        {
          "$ref": "#/$defs/MarkRef"
        }
      ]
    },
    "Labels": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Cell"
      },
      "minItems": 0,
      "maxItems": 30
    },
    "Rows": {
      "type": "object",
      "properties": {
        "first": {
          "$ref": "#/$defs/Row"
        },
        "last": {
          "$ref": "#/$defs/Row"
        }
      },
      "required": [
        "first",
        "last"
      ],
      "additionalProperties": false
    },
    "Mark": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/MarkRef"
        },
        "kind": {
          "type": "string",
          "enum": [
            "symbol",
            "checklist"
          ]
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Name"
          },
          "minItems": 1,
          "maxItems": 50
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Cell"
          },
          "minItems": 1,
          "maxItems": 30
        }
      },
      "required": [
        "id",
        "kind",
        "options",
        "evidence"
      ],
      "additionalProperties": false
    },
    "Item": {
      "type": "object",
      "properties": {
        "value": {
          "$ref": "#/$defs/Cell"
        },
        "labels": {
          "$ref": "#/$defs/Labels"
        },
        "name": {
          "anyOf": [
            {
              "$ref": "#/$defs/Name"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "value",
        "labels",
        "name"
      ],
      "additionalProperties": false
    },
    "Fields": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "fields"
          ]
        },
        "parent": {
          "anyOf": [
            {
              "$ref": "#/$defs/Cell"
            },
            {
              "type": "null"
            }
          ]
        },
        "axis": {
          "type": "string",
          "enum": [
            "horizontal",
            "vertical",
            "direct"
          ]
        },
        "reading": {
          "$ref": "#/$defs/Reading"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Item"
          },
          "minItems": 1,
          "maxItems": 500
        }
      },
      "required": [
        "kind",
        "parent",
        "axis",
        "reading",
        "items"
      ],
      "additionalProperties": false
    },
    "Form": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "form"
          ]
        },
        "grid": {
          "$ref": "#/$defs/Grid"
        },
        "rows": {
          "$ref": "#/$defs/Rows"
        },
        "parent": {
          "anyOf": [
            {
              "$ref": "#/$defs/Cell"
            },
            {
              "type": "null"
            }
          ]
        },
        "labelColumns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Column"
          },
          "minItems": 1,
          "maxItems": 30
        },
        "valueColumn": {
          "$ref": "#/$defs/Column"
        },
        "reading": {
          "$ref": "#/$defs/Reading"
        }
      },
      "required": [
        "kind",
        "grid",
        "rows",
        "parent",
        "labelColumns",
        "valueColumn",
        "reading"
      ],
      "additionalProperties": false
    },
    "ValueColumn": {
      "type": "object",
      "properties": {
        "column": {
          "$ref": "#/$defs/Column"
        },
        "use": {
          "type": "string",
          "enum": [
            "value"
          ]
        },
        "labels": {
          "$ref": "#/$defs/Labels"
        },
        "name": {
          "anyOf": [
            {
              "$ref": "#/$defs/Name"
            },
            {
              "type": "null"
            }
          ]
        },
        "reading": {
          "$ref": "#/$defs/Reading"
        }
      },
      "required": [
        "column",
        "use",
        "labels",
        "name",
        "reading"
      ],
      "additionalProperties": false
    },
    "OtherColumn": {
      "type": "object",
      "properties": {
        "column": {
          "$ref": "#/$defs/Column"
        },
        "use": {
          "type": "string",
          "enum": [
            "row_label",
            "row_key",
            "context",
            "unknown"
          ]
        },
        "headers": {
          "$ref": "#/$defs/Labels"
        }
      },
      "required": [
        "column",
        "use",
        "headers"
      ],
      "additionalProperties": false
    },
    "Records": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "records"
          ]
        },
        "grid": {
          "$ref": "#/$defs/Grid"
        },
        "rows": {
          "$ref": "#/$defs/Rows"
        },
        "parent": {
          "anyOf": [
            {
              "$ref": "#/$defs/Cell"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "anyOf": [
            {
              "$ref": "#/$defs/Name"
            },
            {
              "type": "null"
            }
          ]
        },
        "columns": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/ValueColumn"
              },
              {
                "$ref": "#/$defs/OtherColumn"
              }
            ]
          },
          "minItems": 1,
          "maxItems": 100
        },
        "rowKeyStrategy": {
          "type": "string",
          "enum": [
            "printed",
            "position"
          ]
        },
        "includeEmptyRows": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "grid",
        "rows",
        "parent",
        "name",
        "columns",
        "rowKeyStrategy",
        "includeEmptyRows"
      ],
      "additionalProperties": false
    },
    "RoleGroup": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "label",
            "input",
            "mark",
            "record_key_cell",
            "column_key_cell",
            "ignored",
            "unknown"
          ]
        },
        "reason": {
          "type": "string",
          "enum": [
            "unbound_label",
            "missing_binding",
            "unsupported_mark_definition",
            "printed_index",
            "instruction_or_decoration",
            "uncertain"
          ]
        },
        "cells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Cell"
          },
          "minItems": 1,
          "maxItems": 1000
        }
      },
      "required": [
        "role",
        "reason",
        "cells"
      ],
      "additionalProperties": false
    },
    "Hierarchy": {
      "type": "object",
      "properties": {
        "child": {
          "$ref": "#/$defs/Cell"
        },
        "parent": {
          "$ref": "#/$defs/Cell"
        }
      },
      "required": [
        "child",
        "parent"
      ],
      "additionalProperties": false
    }
  }
}
