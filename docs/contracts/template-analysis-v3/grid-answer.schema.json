{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AcceptedGrid": {
      "additionalProperties": false,
      "properties": {
        "grid": {
          "pattern": "^g_[a-f0-9]{20}$",
          "title": "Grid",
          "type": "string"
        },
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "parent": {
          "anyOf": [
            {
              "pattern": "^c[1-9][0-9]{0,3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parent"
        },
        "columns": {
          "items": {
            "$ref": "#/$defs/AcceptedGridColumn"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Columns",
          "type": "array"
        },
        "reason": {
          "title": "Reason",
          "type": "null"
        }
      },
      "required": [
        "grid",
        "name",
        "parent",
        "columns",
        "reason"
      ],
      "title": "AcceptedGrid",
      "type": "object"
    },
    "AcceptedGridColumn": {
      "additionalProperties": false,
      "properties": {
        "header": {
          "pattern": "^c[1-9][0-9]{0,3}$",
          "title": "Header",
          "type": "string"
        },
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "reading": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_]{0,39}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reading"
        }
      },
      "required": [
        "header",
        "name",
        "reading"
      ],
      "title": "AcceptedGridColumn",
      "type": "object"
    },
    "GridColumn": {
      "additionalProperties": false,
      "properties": {
        "header": {
          "pattern": "^c[1-9][0-9]{0,3}$",
          "title": "Header",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Name"
        },
        "reading": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_]{0,39}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reading"
        }
      },
      "required": [
        "header",
        "name",
        "reading"
      ],
      "title": "GridColumn",
      "type": "object"
    },
    "HeldGrid": {
      "additionalProperties": false,
      "properties": {
        "grid": {
          "pattern": "^g_[a-f0-9]{20}$",
          "title": "Grid",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Name"
        },
        "parent": {
          "anyOf": [
            {
              "pattern": "^c[1-9][0-9]{0,3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parent"
        },
        "columns": {
          "items": {
            "$ref": "#/$defs/GridColumn"
          },
          "maxItems": 100,
          "title": "Columns",
          "type": "array"
        },
        "reason": {
          "enum": [
            "ambiguous_role",
            "ambiguous_binding",
            "ambiguous_parent",
            "missing_evidence",
            "missing_binding",
            "unsupported_mark_definition",
            "unsupported_structure",
            "protected_existing"
          ],
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "grid",
        "name",
        "parent",
        "columns",
        "reason"
      ],
      "title": "HeldGrid",
      "type": "object"
    },
    "Reading": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,39}$",
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "enum": [
            "symbol",
            "checklist"
          ],
          "title": "Kind",
          "type": "string"
        },
        "options": {
          "items": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Options",
          "type": "array"
        },
        "evidenceRefs": {
          "items": {
            "pattern": "^c[1-9][0-9]{0,3}$",
            "type": "string"
          },
          "maxItems": 30,
          "title": "Evidencerefs",
          "type": "array"
        },
        "evidenceText": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Evidencetext",
          "type": "string"
        }
      },
      "required": [
        "key",
        "kind",
        "options",
        "evidenceRefs",
        "evidenceText"
      ],
      "title": "Reading",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "template-analysis.grid.v1",
      "title": "Version",
      "type": "string"
    },
    "readings": {
      "items": {
        "$ref": "#/$defs/Reading"
      },
      "maxItems": 100,
      "title": "Readings",
      "type": "array"
    },
    "grid": {
      "anyOf": [
        {
          "$ref": "#/$defs/AcceptedGrid"
        },
        {
          "$ref": "#/$defs/HeldGrid"
        }
      ],
      "title": "Grid"
    }
  },
  "required": [
    "version",
    "readings",
    "grid"
  ],
  "title": "GridVisualAnswer",
  "type": "object"
}
