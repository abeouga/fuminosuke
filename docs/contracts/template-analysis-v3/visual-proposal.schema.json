{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Column": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,39}$",
          "title": "Key",
          "type": "string"
        },
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "labels": {
          "items": {
            "pattern": "^c[1-9][0-9]{0,3}$",
            "type": "string"
          },
          "maxItems": 30,
          "title": "Labels",
          "type": "array"
        }
      },
      "required": [
        "key",
        "name",
        "labels"
      ],
      "title": "Column",
      "type": "object"
    },
    "FieldProposal": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,39}$",
          "title": "Key",
          "type": "string"
        },
        "cell": {
          "pattern": "^c[1-9][0-9]{0,3}$",
          "title": "Cell",
          "type": "string"
        },
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "labels": {
          "items": {
            "pattern": "^c[1-9][0-9]{0,3}$",
            "type": "string"
          },
          "maxItems": 30,
          "title": "Labels",
          "type": "array"
        },
        "axis": {
          "description": "labelsが空ならdirect。labelsが一つ以上あればhorizontal又はvertical。",
          "enum": [
            "horizontal",
            "vertical",
            "direct"
          ],
          "title": "Axis",
          "type": "string"
        },
        "parent": {
          "anyOf": [
            {
              "pattern": "^c[1-9][0-9]{0,3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parent"
        }
      },
      "required": [
        "key",
        "cell",
        "name",
        "labels",
        "axis",
        "parent"
      ],
      "title": "FieldProposal",
      "type": "object"
    },
    "Issue": {
      "additionalProperties": false,
      "properties": {
        "cell": {
          "pattern": "^c[1-9][0-9]{0,3}$",
          "title": "Cell",
          "type": "string"
        },
        "reason": {
          "enum": [
            "ambiguous_role",
            "ambiguous_binding",
            "ambiguous_parent",
            "missing_evidence",
            "missing_binding",
            "unsupported_mark_definition",
            "unsupported_structure",
            "protected_existing"
          ],
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "cell",
        "reason"
      ],
      "title": "Issue",
      "type": "object"
    },
    "Roles": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "items": {
            "pattern": "^c[1-9][0-9]{0,3}$",
            "type": "string"
          },
          "maxItems": 1000,
          "title": "Label",
          "type": "array"
        },
        "parent_label": {
          "items": {
            "pattern": "^c[1-9][0-9]{0,3}$",
            "type": "string"
          },
          "maxItems": 1000,
          "title": "Parent Label",
          "type": "array"
        },
        "input": {
          "items": {
            "pattern": "^c[1-9][0-9]{0,3}$",
            "type": "string"
          },
          "maxItems": 1000,
          "title": "Input",
          "type": "array"
        },
        "mark": {
          "items": {
            "pattern": "^c[1-9][0-9]{0,3}$",
            "type": "string"
          },
          "maxItems": 1000,
          "title": "Mark",
          "type": "array"
        },
        "record_key_cell": {
          "items": {
            "pattern": "^c[1-9][0-9]{0,3}$",
            "type": "string"
          },
          "maxItems": 1000,
          "title": "Record Key Cell",
          "type": "array"
        },
        "column_key_cell": {
          "items": {
            "pattern": "^c[1-9][0-9]{0,3}$",
            "type": "string"
          },
          "maxItems": 1000,
          "title": "Column Key Cell",
          "type": "array"
        },
        "ignored": {
          "items": {
            "pattern": "^c[1-9][0-9]{0,3}$",
            "type": "string"
          },
          "maxItems": 1000,
          "title": "Ignored",
          "type": "array"
        },
        "unknown": {
          "items": {
            "pattern": "^c[1-9][0-9]{0,3}$",
            "type": "string"
          },
          "maxItems": 1000,
          "title": "Unknown",
          "type": "array"
        }
      },
      "required": [
        "label",
        "parent_label",
        "input",
        "mark",
        "record_key_cell",
        "column_key_cell",
        "ignored",
        "unknown"
      ],
      "title": "Roles",
      "type": "object"
    },
    "Row": {
      "additionalProperties": false,
      "properties": {
        "cells": {
          "items": {
            "pattern": "^c[1-9][0-9]{0,3}$",
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Cells",
          "type": "array"
        },
        "keyCell": {
          "anyOf": [
            {
              "pattern": "^c[1-9][0-9]{0,3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Keycell"
        },
        "keyValue": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Keyvalue"
        }
      },
      "required": [
        "cells",
        "keyCell",
        "keyValue"
      ],
      "title": "Row",
      "type": "object"
    },
    "Table": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,39}$",
          "title": "Key",
          "type": "string"
        },
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "parent": {
          "anyOf": [
            {
              "pattern": "^c[1-9][0-9]{0,3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parent"
        },
        "columns": {
          "items": {
            "$ref": "#/$defs/Column"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Columns",
          "type": "array"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/Row"
          },
          "maxItems": 300,
          "minItems": 1,
          "title": "Rows",
          "type": "array"
        },
        "rowKeyStrategy": {
          "enum": [
            "printed",
            "position"
          ],
          "title": "Rowkeystrategy",
          "type": "string"
        },
        "includeEmptyRows": {
          "title": "Includeemptyrows",
          "type": "boolean"
        }
      },
      "required": [
        "key",
        "name",
        "parent",
        "columns",
        "rows",
        "rowKeyStrategy",
        "includeEmptyRows"
      ],
      "title": "Table",
      "type": "object"
    },
    "VisualHeading": {
      "additionalProperties": false,
      "properties": {
        "cell": {
          "pattern": "^c[1-9][0-9]{0,3}$",
          "title": "Cell",
          "type": "string"
        },
        "parent": {
          "anyOf": [
            {
              "pattern": "^c[1-9][0-9]{0,3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parent"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Name"
        }
      },
      "required": [
        "cell",
        "parent",
        "name"
      ],
      "title": "VisualHeading",
      "type": "object"
    },
    "VisualMark": {
      "additionalProperties": false,
      "properties": {
        "cells": {
          "items": {
            "pattern": "^c[1-9][0-9]{0,3}$",
            "type": "string"
          },
          "maxItems": 320,
          "minItems": 1,
          "title": "Cells",
          "type": "array"
        },
        "kind": {
          "enum": [
            "symbol",
            "checklist"
          ],
          "title": "Kind",
          "type": "string"
        },
        "options": {
          "items": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Options",
          "type": "array"
        },
        "evidenceRefs": {
          "items": {
            "pattern": "^c[1-9][0-9]{0,3}$",
            "type": "string"
          },
          "maxItems": 30,
          "title": "Evidencerefs",
          "type": "array"
        },
        "evidenceText": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Evidencetext",
          "type": "string"
        }
      },
      "required": [
        "cells",
        "kind",
        "options",
        "evidenceRefs",
        "evidenceText"
      ],
      "title": "VisualMark",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "template-analysis.visual.v2",
      "title": "Version",
      "type": "string"
    },
    "roles": {
      "$ref": "#/$defs/Roles"
    },
    "headings": {
      "items": {
        "$ref": "#/$defs/VisualHeading"
      },
      "maxItems": 1000,
      "title": "Headings",
      "type": "array"
    },
    "fields": {
      "items": {
        "$ref": "#/$defs/FieldProposal"
      },
      "maxItems": 500,
      "title": "Fields",
      "type": "array"
    },
    "tables": {
      "items": {
        "$ref": "#/$defs/Table"
      },
      "maxItems": 100,
      "title": "Tables",
      "type": "array"
    },
    "marks": {
      "items": {
        "$ref": "#/$defs/VisualMark"
      },
      "maxItems": 320,
      "title": "Marks",
      "type": "array"
    },
    "unresolved": {
      "items": {
        "$ref": "#/$defs/Issue"
      },
      "maxItems": 1000,
      "title": "Unresolved",
      "type": "array"
    }
  },
  "required": [
    "version",
    "roles",
    "headings",
    "fields",
    "tables",
    "marks",
    "unresolved"
  ],
  "title": "VisualProposal",
  "type": "object"
}
