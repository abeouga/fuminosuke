{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Add": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "add",
          "title": "Op",
          "type": "string"
        },
        "ref": {
          "pattern": "^n[1-9][0-9]{0,3}$",
          "title": "Ref",
          "type": "string"
        },
        "rect": {
          "$ref": "#/$defs/Rectangle"
        }
      },
      "required": [
        "op",
        "ref",
        "rect"
      ],
      "title": "Add",
      "type": "object"
    },
    "InputColumn": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,39}$",
          "title": "Key",
          "type": "string"
        },
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "reading": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_]{0,39}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reading"
        },
        "binding": {
          "anyOf": [
            {
              "$ref": "#/$defs/LabelledInput"
            },
            {
              "$ref": "#/$defs/RegionUnlabelled"
            }
          ],
          "title": "Binding"
        }
      },
      "required": [
        "key",
        "name",
        "reading",
        "binding"
      ],
      "title": "InputColumn",
      "type": "object"
    },
    "InputField": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "binding": {
          "anyOf": [
            {
              "$ref": "#/$defs/LabelledInput"
            },
            {
              "$ref": "#/$defs/RegionUnlabelled"
            }
          ],
          "title": "Binding"
        }
      },
      "required": [
        "name",
        "binding"
      ],
      "title": "InputField",
      "type": "object"
    },
    "InputGroup": {
      "additionalProperties": false,
      "properties": {
        "parent": {
          "anyOf": [
            {
              "pattern": "^[cn][1-9][0-9]{0,3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parent"
        },
        "reading": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_]{0,39}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reading"
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/InputField"
          },
          "maxItems": 320,
          "minItems": 1,
          "title": "Fields",
          "type": "array"
        }
      },
      "required": [
        "parent",
        "reading",
        "fields"
      ],
      "title": "InputGroup",
      "type": "object"
    },
    "InputSemantics": {
      "additionalProperties": false,
      "properties": {
        "readings": {
          "items": {
            "$ref": "#/$defs/RegionReading"
          },
          "maxItems": 320,
          "title": "Readings",
          "type": "array"
        },
        "headings": {
          "items": {
            "$ref": "#/$defs/RegionHeading"
          },
          "maxItems": 1000,
          "title": "Headings",
          "type": "array"
        },
        "annotations": {
          "items": {
            "$ref": "#/$defs/RegionAnnotation"
          },
          "maxItems": 1000,
          "title": "Annotations",
          "type": "array"
        },
        "groups": {
          "items": {
            "$ref": "#/$defs/InputGroup"
          },
          "maxItems": 320,
          "title": "Groups",
          "type": "array"
        },
        "tables": {
          "items": {
            "$ref": "#/$defs/InputTable"
          },
          "maxItems": 100,
          "title": "Tables",
          "type": "array"
        },
        "unresolved": {
          "items": {
            "$ref": "#/$defs/RegionProblem"
          },
          "maxItems": 1000,
          "title": "Unresolved",
          "type": "array"
        }
      },
      "required": [
        "readings",
        "headings",
        "annotations",
        "groups",
        "tables",
        "unresolved"
      ],
      "title": "InputSemantics",
      "type": "object"
    },
    "InputTable": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,39}$",
          "title": "Key",
          "type": "string"
        },
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "parent": {
          "anyOf": [
            {
              "pattern": "^[cn][1-9][0-9]{0,3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parent"
        },
        "columns": {
          "items": {
            "$ref": "#/$defs/InputColumn"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Columns",
          "type": "array"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/RegionRow"
          },
          "maxItems": 300,
          "minItems": 1,
          "title": "Rows",
          "type": "array"
        },
        "rowKeyStrategy": {
          "enum": [
            "printed",
            "position"
          ],
          "title": "Rowkeystrategy",
          "type": "string"
        },
        "includeEmptyRows": {
          "title": "Includeemptyrows",
          "type": "boolean"
        }
      },
      "required": [
        "key",
        "name",
        "parent",
        "columns",
        "rows",
        "rowKeyStrategy",
        "includeEmptyRows"
      ],
      "title": "InputTable",
      "type": "object"
    },
    "LabelledInput": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "labelled",
          "title": "Kind",
          "type": "string"
        },
        "input": {
          "pattern": "^[cn][1-9][0-9]{0,3}$",
          "title": "Input",
          "type": "string"
        },
        "labels": {
          "items": {
            "pattern": "^[cn][1-9][0-9]{0,3}$",
            "type": "string"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Labels",
          "type": "array"
        },
        "axis": {
          "enum": [
            "horizontal",
            "vertical"
          ],
          "title": "Axis",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "input",
        "labels",
        "axis"
      ],
      "title": "LabelledInput",
      "type": "object"
    },
    "Merge": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "merge",
          "title": "Op",
          "type": "string"
        },
        "cells": {
          "items": {
            "pattern": "^c[1-9][0-9]{0,3}$",
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 2,
          "title": "Cells",
          "type": "array"
        },
        "ref": {
          "pattern": "^n[1-9][0-9]{0,3}$",
          "title": "Ref",
          "type": "string"
        }
      },
      "required": [
        "op",
        "cells",
        "ref"
      ],
      "title": "Merge",
      "type": "object"
    },
    "NewRectangle": {
      "additionalProperties": false,
      "properties": {
        "ref": {
          "pattern": "^n[1-9][0-9]{0,3}$",
          "title": "Ref",
          "type": "string"
        },
        "rect": {
          "$ref": "#/$defs/Rectangle"
        }
      },
      "required": [
        "ref",
        "rect"
      ],
      "title": "NewRectangle",
      "type": "object"
    },
    "Rectangle": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "maximum": 20000,
          "minimum": 0,
          "title": "X",
          "type": "integer"
        },
        "y": {
          "maximum": 20000,
          "minimum": 0,
          "title": "Y",
          "type": "integer"
        },
        "width": {
          "maximum": 20000,
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "maximum": 20000,
          "minimum": 1,
          "title": "Height",
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "Rectangle",
      "type": "object"
    },
    "RegionAnnotation": {
      "additionalProperties": false,
      "properties": {
        "cell": {
          "pattern": "^[cn][1-9][0-9]{0,3}$",
          "title": "Cell",
          "type": "string"
        },
        "role": {
          "enum": [
            "label",
            "ignored",
            "record_key_cell",
            "column_key_cell"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "cell",
        "role"
      ],
      "title": "RegionAnnotation",
      "type": "object"
    },
    "RegionEvidence": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "enum": [
            "free_entry",
            "in_cell_caption"
          ],
          "title": "Basis",
          "type": "string"
        },
        "text": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "refs": {
          "items": {
            "pattern": "^[cn][1-9][0-9]{0,3}$",
            "type": "string"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Refs",
          "type": "array"
        }
      },
      "required": [
        "basis",
        "text",
        "refs"
      ],
      "title": "RegionEvidence",
      "type": "object"
    },
    "RegionHeading": {
      "additionalProperties": false,
      "properties": {
        "cell": {
          "pattern": "^[cn][1-9][0-9]{0,3}$",
          "title": "Cell",
          "type": "string"
        },
        "parent": {
          "anyOf": [
            {
              "pattern": "^[cn][1-9][0-9]{0,3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parent"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Name"
        }
      },
      "required": [
        "cell",
        "parent",
        "name"
      ],
      "title": "RegionHeading",
      "type": "object"
    },
    "RegionProblem": {
      "additionalProperties": false,
      "properties": {
        "cell": {
          "anyOf": [
            {
              "pattern": "^[cn][1-9][0-9]{0,3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cell"
        },
        "bounds": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rectangle"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "anyOf": [
            {
              "enum": [
                "ambiguous_role",
                "ambiguous_binding",
                "ambiguous_parent",
                "missing_evidence",
                "missing_binding",
                "unsupported_mark_definition",
                "unsupported_structure",
                "protected_existing"
              ],
              "type": "string"
            },
            {
              "enum": [
                "manual_required",
                "cross_region"
              ],
              "type": "string"
            }
          ],
          "title": "Reason"
        }
      },
      "required": [
        "cell",
        "bounds",
        "reason"
      ],
      "title": "RegionProblem",
      "type": "object"
    },
    "RegionReading": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,39}$",
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "enum": [
            "symbol",
            "checklist"
          ],
          "title": "Kind",
          "type": "string"
        },
        "options": {
          "items": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Options",
          "type": "array"
        },
        "evidenceRefs": {
          "items": {
            "pattern": "^[cn][1-9][0-9]{0,3}$",
            "type": "string"
          },
          "maxItems": 30,
          "title": "Evidencerefs",
          "type": "array"
        },
        "evidenceText": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Evidencetext",
          "type": "string"
        }
      },
      "required": [
        "key",
        "kind",
        "options",
        "evidenceRefs",
        "evidenceText"
      ],
      "title": "RegionReading",
      "type": "object"
    },
    "RegionRow": {
      "additionalProperties": false,
      "properties": {
        "cells": {
          "items": {
            "pattern": "^[cn][1-9][0-9]{0,3}$",
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Cells",
          "type": "array"
        },
        "keyCell": {
          "anyOf": [
            {
              "pattern": "^[cn][1-9][0-9]{0,3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Keycell"
        },
        "keyValue": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Keyvalue"
        }
      },
      "required": [
        "cells",
        "keyCell",
        "keyValue"
      ],
      "title": "RegionRow",
      "type": "object"
    },
    "RegionUnlabelled": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "unlabelled",
          "title": "Kind",
          "type": "string"
        },
        "cell": {
          "pattern": "^[cn][1-9][0-9]{0,3}$",
          "title": "Cell",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/RegionEvidence"
        }
      },
      "required": [
        "kind",
        "cell",
        "evidence"
      ],
      "title": "RegionUnlabelled",
      "type": "object"
    },
    "RemoveDuplicate": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "remove_duplicate",
          "title": "Op",
          "type": "string"
        },
        "cell": {
          "pattern": "^c[1-9][0-9]{0,3}$",
          "title": "Cell",
          "type": "string"
        },
        "survivors": {
          "items": {
            "pattern": "^[cn][1-9][0-9]{0,3}$",
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Survivors",
          "type": "array"
        }
      },
      "required": [
        "op",
        "cell",
        "survivors"
      ],
      "title": "RemoveDuplicate",
      "type": "object"
    },
    "Resize": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "resize",
          "title": "Op",
          "type": "string"
        },
        "cell": {
          "pattern": "^c[1-9][0-9]{0,3}$",
          "title": "Cell",
          "type": "string"
        },
        "rect": {
          "$ref": "#/$defs/Rectangle"
        }
      },
      "required": [
        "op",
        "cell",
        "rect"
      ],
      "title": "Resize",
      "type": "object"
    },
    "Split": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "split",
          "title": "Op",
          "type": "string"
        },
        "cell": {
          "pattern": "^c[1-9][0-9]{0,3}$",
          "title": "Cell",
          "type": "string"
        },
        "parts": {
          "items": {
            "$ref": "#/$defs/NewRectangle"
          },
          "maxItems": 100,
          "minItems": 2,
          "title": "Parts",
          "type": "array"
        }
      },
      "required": [
        "op",
        "cell",
        "parts"
      ],
      "title": "Split",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "template-analysis.region.v1",
      "title": "Version",
      "type": "string"
    },
    "catalogDigest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Catalogdigest",
      "type": "string"
    },
    "geometry": {
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/Add"
          },
          {
            "$ref": "#/$defs/Resize"
          },
          {
            "$ref": "#/$defs/Split"
          },
          {
            "$ref": "#/$defs/Merge"
          },
          {
            "$ref": "#/$defs/RemoveDuplicate"
          }
        ]
      },
      "maxItems": 100,
      "title": "Geometry",
      "type": "array"
    },
    "semantics": {
      "$ref": "#/$defs/InputSemantics"
    }
  },
  "required": [
    "version",
    "catalogDigest",
    "geometry",
    "semantics"
  ],
  "title": "RegionAnswer",
  "type": "object"
}
