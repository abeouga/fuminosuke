{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Annotation": {
      "additionalProperties": false,
      "properties": {
        "cell": {
          "pattern": "^c[1-9][0-9]{0,3}$",
          "title": "Cell",
          "type": "string"
        },
        "role": {
          "enum": [
            "label",
            "ignored",
            "record_key_cell",
            "column_key_cell"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "cell",
        "role"
      ],
      "title": "Annotation",
      "type": "object"
    },
    "FormColumn": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,39}$",
          "title": "Key",
          "type": "string"
        },
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "reading": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_]{0,39}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reading"
        },
        "binding": {
          "anyOf": [
            {
              "$ref": "#/$defs/LinkedBinding"
            },
            {
              "$ref": "#/$defs/UnlabelledBinding"
            }
          ],
          "title": "Binding"
        }
      },
      "required": [
        "key",
        "name",
        "reading",
        "binding"
      ],
      "title": "FormColumn",
      "type": "object"
    },
    "FormField": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "binding": {
          "anyOf": [
            {
              "$ref": "#/$defs/LinkedBinding"
            },
            {
              "$ref": "#/$defs/UnlabelledBinding"
            }
          ],
          "title": "Binding"
        }
      },
      "required": [
        "name",
        "binding"
      ],
      "title": "FormField",
      "type": "object"
    },
    "FormGroup": {
      "additionalProperties": false,
      "properties": {
        "parent": {
          "anyOf": [
            {
              "pattern": "^c[1-9][0-9]{0,3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parent"
        },
        "reading": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_]{0,39}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reading"
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/FormField"
          },
          "maxItems": 320,
          "minItems": 1,
          "title": "Fields",
          "type": "array"
        }
      },
      "required": [
        "parent",
        "reading",
        "fields"
      ],
      "title": "FormGroup",
      "type": "object"
    },
    "FormTable": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,39}$",
          "title": "Key",
          "type": "string"
        },
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "parent": {
          "anyOf": [
            {
              "pattern": "^c[1-9][0-9]{0,3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parent"
        },
        "columns": {
          "items": {
            "$ref": "#/$defs/FormColumn"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Columns",
          "type": "array"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/Row"
          },
          "maxItems": 300,
          "minItems": 1,
          "title": "Rows",
          "type": "array"
        },
        "rowKeyStrategy": {
          "enum": [
            "printed",
            "position"
          ],
          "title": "Rowkeystrategy",
          "type": "string"
        },
        "includeEmptyRows": {
          "title": "Includeemptyrows",
          "type": "boolean"
        }
      },
      "required": [
        "key",
        "name",
        "parent",
        "columns",
        "rows",
        "rowKeyStrategy",
        "includeEmptyRows"
      ],
      "title": "FormTable",
      "type": "object"
    },
    "Issue": {
      "additionalProperties": false,
      "properties": {
        "cell": {
          "pattern": "^c[1-9][0-9]{0,3}$",
          "title": "Cell",
          "type": "string"
        },
        "reason": {
          "enum": [
            "ambiguous_role",
            "ambiguous_binding",
            "ambiguous_parent",
            "missing_evidence",
            "missing_binding",
            "unsupported_mark_definition",
            "unsupported_structure",
            "protected_existing"
          ],
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "cell",
        "reason"
      ],
      "title": "Issue",
      "type": "object"
    },
    "LinkedBinding": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "linked",
          "title": "Kind",
          "type": "string"
        },
        "links": {
          "items": {
            "pattern": "^b[1-9][0-9]{0,3}$",
            "type": "string"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Links",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "links"
      ],
      "title": "LinkedBinding",
      "type": "object"
    },
    "Reading": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,39}$",
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "enum": [
            "symbol",
            "checklist"
          ],
          "title": "Kind",
          "type": "string"
        },
        "options": {
          "items": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Options",
          "type": "array"
        },
        "evidenceRefs": {
          "items": {
            "pattern": "^c[1-9][0-9]{0,3}$",
            "type": "string"
          },
          "maxItems": 30,
          "title": "Evidencerefs",
          "type": "array"
        },
        "evidenceText": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Evidencetext",
          "type": "string"
        }
      },
      "required": [
        "key",
        "kind",
        "options",
        "evidenceRefs",
        "evidenceText"
      ],
      "title": "Reading",
      "type": "object"
    },
    "Row": {
      "additionalProperties": false,
      "properties": {
        "cells": {
          "items": {
            "pattern": "^c[1-9][0-9]{0,3}$",
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Cells",
          "type": "array"
        },
        "keyCell": {
          "anyOf": [
            {
              "pattern": "^c[1-9][0-9]{0,3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Keycell"
        },
        "keyValue": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Keyvalue"
        }
      },
      "required": [
        "cells",
        "keyCell",
        "keyValue"
      ],
      "title": "Row",
      "type": "object"
    },
    "UnlabelledBinding": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "unlabelled",
          "title": "Kind",
          "type": "string"
        },
        "cell": {
          "pattern": "^c[1-9][0-9]{0,3}$",
          "title": "Cell",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/UnlabelledEvidence"
        }
      },
      "required": [
        "kind",
        "cell",
        "evidence"
      ],
      "title": "UnlabelledBinding",
      "type": "object"
    },
    "UnlabelledEvidence": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "enum": [
            "free_entry",
            "in_cell_caption"
          ],
          "title": "Basis",
          "type": "string"
        },
        "text": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "refs": {
          "items": {
            "pattern": "^c[1-9][0-9]{0,3}$",
            "type": "string"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Refs",
          "type": "array"
        }
      },
      "required": [
        "basis",
        "text",
        "refs"
      ],
      "title": "UnlabelledEvidence",
      "type": "object"
    },
    "VisualHeading": {
      "additionalProperties": false,
      "properties": {
        "cell": {
          "pattern": "^c[1-9][0-9]{0,3}$",
          "title": "Cell",
          "type": "string"
        },
        "parent": {
          "anyOf": [
            {
              "pattern": "^c[1-9][0-9]{0,3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parent"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Name"
        }
      },
      "required": [
        "cell",
        "parent",
        "name"
      ],
      "title": "VisualHeading",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "template-analysis.form.v2",
      "title": "Version",
      "type": "string"
    },
    "catalogDigest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Catalogdigest",
      "type": "string"
    },
    "readings": {
      "items": {
        "$ref": "#/$defs/Reading"
      },
      "maxItems": 320,
      "title": "Readings",
      "type": "array"
    },
    "groups": {
      "items": {
        "$ref": "#/$defs/FormGroup"
      },
      "maxItems": 320,
      "title": "Groups",
      "type": "array"
    },
    "headings": {
      "items": {
        "$ref": "#/$defs/VisualHeading"
      },
      "maxItems": 1000,
      "title": "Headings",
      "type": "array"
    },
    "annotations": {
      "items": {
        "$ref": "#/$defs/Annotation"
      },
      "maxItems": 1000,
      "title": "Annotations",
      "type": "array"
    },
    "tables": {
      "items": {
        "$ref": "#/$defs/FormTable"
      },
      "maxItems": 100,
      "title": "Tables",
      "type": "array"
    },
    "unresolved": {
      "items": {
        "$ref": "#/$defs/Issue"
      },
      "maxItems": 1000,
      "title": "Unresolved",
      "type": "array"
    }
  },
  "required": [
    "version",
    "catalogDigest",
    "readings",
    "groups",
    "headings",
    "annotations",
    "tables",
    "unresolved"
  ],
  "title": "FormVisualAnswer",
  "type": "object"
}
