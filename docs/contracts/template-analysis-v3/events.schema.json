{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AnalysisError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "AnalysisError",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contractVersion": {
      "const": "template-analysis.v3",
      "title": "Contractversion",
      "type": "string"
    },
    "analysisId": {
      "pattern": "^[A-Za-z0-9_-]{1,128}$",
      "title": "Analysisid",
      "type": "string"
    },
    "snapshotDigest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Snapshotdigest",
      "type": "string"
    },
    "sequence": {
      "title": "Sequence",
      "type": "integer"
    },
    "type": {
      "enum": [
        "accepted",
        "page_started",
        "page_validated",
        "region_validated",
        "progress",
        "ready",
        "partial",
        "failed",
        "cancelled",
        "expired",
        "stale"
      ],
      "title": "Type",
      "type": "string"
    },
    "emittedAt": {
      "title": "Emittedat",
      "type": "string"
    },
    "plannedCalls": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Plannedcalls"
    },
    "pageId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pageid"
    },
    "state": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "State"
    },
    "unitCount": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unitcount"
    },
    "unresolvedCount": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unresolvedcount"
    },
    "proposalDigest": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Proposaldigest"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/AnalysisError"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "contractVersion",
    "analysisId",
    "snapshotDigest",
    "sequence",
    "type",
    "emittedAt"
  ],
  "title": "AnalysisEventResult",
  "type": "object"
}
