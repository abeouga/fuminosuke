.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
node_modules/
*.tsbuildinfo
*.egg-info/

# Terraform runtime state and local Google credentials.
.terraform/
*.tfstate
*.tfstate.*
terraform.tfvars
*.auto.tfvars
crash.log
/llm-ocr-sheets-*.json

# The existing runtime file is retained for compatibility. Do not add new
# credentials to it; machine-local secrets belong in backend/.env.local.
!backend/.env

# Machine-local overrides must never be committed. New credentials belong here.
/backend/.env.local

# Test-run artifacts generated under the backend workspace.
backend/.pytest-full-mapping-*/

data/**
!data/.gitkeep
backend/data/**
!backend/data/.gitkeep

# Version the live SQLite database. It is checkpointed before committing;
# volatile write-ahead-log sidecars and other runtime artifacts remain local-only.
!backend/data/app.db

# Sanitized active-template bootstrap data is intentionally versioned so a new
# local runtime starts with the shared templates. It contains no API keys,
# uploaded source images, OCR results, confirmed records, or logs.
!backend/bootstrap/
!backend/bootstrap/templates/
!backend/bootstrap/templates/**
