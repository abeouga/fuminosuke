.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
node_modules/
*.tsbuildinfo
*.egg-info/

# Terraform runtime state and local Google credentials.
.terraform/
*.tfstate
*.tfstate.*
terraform.tfvars
*.auto.tfvars
*.tfvars.json
*.tfplan
crash.log
/llm-ocr-sheets-*.json

# Machine-local credentials and overrides must never be committed.
/backend/.env
/backend/.env.local

# Test-run artifacts generated under the backend workspace.
backend/.pytest-full-mapping-*/

data/**
!data/.gitkeep
backend/data/**
!backend/data/.gitkeep

# Sanitized active-template bootstrap data is intentionally versioned so a new
# local runtime starts with the shared templates. It contains no API keys,
# uploaded source images, OCR results, confirmed records, or logs.
!backend/bootstrap/
!backend/bootstrap/templates/
!backend/bootstrap/templates/**

# Built per machine; they hold this PC's paths and change on every build.
sysover-ray/SysOverRay/bin/
sysover-ray/SysOverRay/obj/
# Made by sysover-ray/Install-SysOverRay.ps1 with this checkout's absolute path.
sysover-ray/app/SysOverRay.exe
sysover-ray/app/*.pdb
sysover-ray/*.lnk
# Local preview servers point at this PC's folders.
.claude/launch.json

# AI-agent instructions live in the development notes repository; only a short
# local pointer is kept here.
/AGENTS.md
/CLAUDE.md

# Local run records.
tools/chat_qa/last/
backend/*.log
frontend/*.log

# Machine-specific launcher values (paths, printer, scanner address).
tools/ocr-dev-launcher.local.json

# Deployment values and Terraform backend settings for this project's AWS account.
/deploy/cloud.env
backend.hcl
