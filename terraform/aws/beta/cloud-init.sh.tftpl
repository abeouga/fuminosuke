#!/bin/bash
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y docker.io docker-compose-v2 python3 xfsprogs curl unzip
systemctl enable --now docker
install -d -m 0700 /etc/llmocr /opt/llmocr /var/lib/fuminosuke
serial=$(printf '%s' '${data_volume_id}' | tr -d '-')
device=/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_$serial
for attempt in $(seq 1 120); do [ -b "$device" ] && break; sleep 2; done
test -b "$device"
if ! blkid "$device"; then mkfs.xfs "$device"; fi
uuid=$(blkid -s UUID -o value "$device")
printf 'UUID=%s /var/lib/fuminosuke xfs defaults,nofail,prjquota 0 2\n' "$uuid" >> /etc/fstab
mount /var/lib/fuminosuke
install -d -o 10001 -g 10001 -m 0700 /var/lib/fuminosuke/data /var/lib/fuminosuke/work
install -d -o 10001 -g 10001 -m 0700 /var/lib/fuminosuke/caddy
# No source, API key, user account, invitation or AI activation is installed here.
